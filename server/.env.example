PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mentorslot
# MongoDB transactions require a replica set. MongoDB Atlas works; local standalone does not.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MentorSlot <no-reply@example.com>"
# Configure a meeting link you are authorized to use. Do not commit real private links.
DEMO_CLASS_URL=https://example.com/demo-class
BOOKING_DURATION_MINUTES=30
